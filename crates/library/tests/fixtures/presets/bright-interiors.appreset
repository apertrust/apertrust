<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0+4~g1a2b3c4">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    apertrust:preset="1"
    apertrust:name="Bright interiors"
    apertrust:description="Lifts a room &quot;lit&quot; by a window &amp; lamps">
   <apertrust:tools>
    <rdf:Seq>
     <rdf:li>
      <rdf:Description
        apertrust:tool="exposure"
        apertrust:toolVersion="3"
        apertrust:enabled="true"
        apertrust:kept="exposure black_level"
        apertrust:auto="compensate_camera"
        control:exposure="1.2"
        control:black_level="-0.01"/>
     </rdf:li>
    </rdf:Seq>
   </apertrust:tools>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
