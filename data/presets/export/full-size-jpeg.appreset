<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    xmlns:setting="https://apertrust.org/ns/xmp/setting/"
    apertrust:preset="1"
    apertrust:name="Full size JPEG">
   <apertrust:settings>
    <rdf:Description
      apertrust:tool="export"
      setting:export.format="jpeg"
      setting:export.size.mode="pixels"
      setting:export.size.width="0"
      setting:export.size.height="0"
      setting:export.profile="srgb"/>
   </apertrust:settings>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
