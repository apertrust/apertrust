<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    xmlns:setting="https://apertrust.org/ns/xmp/setting/"
    apertrust:preset="1"
    apertrust:name="IPTC for agencies">
   <apertrust:settings>
    <rdf:Description
      apertrust:tool="metadata"
      setting:metadata.shown="title headline description description_writer notes creator job_title email website phone address contact_city contact_region postal_code contact_country copyright_notice usage_terms copyright_status web_statement credit_line source publisher sublocation city state country country_code instructions job_id date_created genre scene_code subject_code"
      setting:metadata.hidden=""
      setting:metadata.open="basic content creator rights location status"/>
   </apertrust:settings>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
