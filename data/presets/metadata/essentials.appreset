<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    xmlns:setting="https://apertrust.org/ns/xmp/setting/"
    apertrust:preset="1"
    apertrust:name="Essentials">
   <apertrust:settings>
    <rdf:Description
      apertrust:tool="metadata"
      setting:metadata.shown="file_name rating colour_labels copy date_taken exposure_time aperture iso lens focal_length title"
      setting:metadata.shown_only="true"
      setting:metadata.open="basic exposure lens content"/>
   </apertrust:settings>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
