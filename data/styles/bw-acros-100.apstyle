<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    apertrust:style="1"
    apertrust:name="Black and white|Acros 100">
   <apertrust:tools>
    <rdf:Seq>
     <rdf:li>
      <rdf:Description
        apertrust:tool="channelmixerrgb"
        apertrust:toolVersion="1"
        control:adaptation="xyz"
        control:illuminant="pipeline"
        control:temperature="5003"
        control:x="0.34567"
        control:y="0.3585"
        control:gamut="0"
        control:grey_r="0.333"
        control:grey_g="0.313"
        control:grey_b="0.353"
        control:grey_normalise="true"/>
     </rdf:li>
    </rdf:Seq>
   </apertrust:tools>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
