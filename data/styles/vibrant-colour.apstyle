<?xml version="1.0" encoding="UTF-8"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Apertrust 0.1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:apertrust="https://apertrust.org/ns/xmp/"
    xmlns:control="https://apertrust.org/ns/xmp/control/"
    apertrust:style="1"
    apertrust:name="Vibrant colour">
   <apertrust:tools>
    <rdf:Seq>
     <rdf:li>
      <rdf:Description
        apertrust:tool="colorbalancergb"
        apertrust:toolVersion="2"
        apertrust:enabled="true"
        control:saturation_global="20"
        control:saturation_shadows="50"
        control:saturation_highlights="-25"/>
     </rdf:li>
    </rdf:Seq>
   </apertrust:tools>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
