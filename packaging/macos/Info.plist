			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dcs</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.apertrust.raw-image.kdc</string>
			<key>UTTypeDescription</key>
			<string>Kodak raw image</string>
			<key>UTTypeConformsTo</key>
			<array>
